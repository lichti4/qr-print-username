<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>QrLabelPrinter</AssemblyName>
    <RootNamespace>QrLabelPrinter</RootNamespace>
    <ApplicationTitle>QR-Etikettendruck</ApplicationTitle>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\QrLabelPrinter.Core\QrLabelPrinter.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fenster-Icon (Taskleiste/Titelleiste) -->
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Liegt nach Build und Publish als editierbare Datei neben der EXE. -->
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
