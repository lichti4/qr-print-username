<Window x:Class="QrLabelPrinter.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:QrLabelPrinter.Views"
        Title="QR-Etikettendruck"
        Width="660" Height="720" MinWidth="520" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- Fehlermeldung -->
            <Border Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                    Background="#FDECEA" BorderBrush="#D93025" BorderThickness="1"
                    CornerRadius="4" Padding="12" Margin="0,0,0,16">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#8A1C14" />
            </Border>

            <!-- Personendaten aus SAP (nur Anzeige) -->
            <TextBlock Text="Angaben aus SAP" FontWeight="Bold" Margin="0,0,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="SAP-Username" Style="{StaticResource FieldLabel}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SapUsername}" Style="{StaticResource FieldValue}" />
                <TextBlock Grid.Row="1" Text="Vorname" Style="{StaticResource FieldLabel}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FirstName}" Style="{StaticResource FieldValue}" />
                <TextBlock Grid.Row="2" Text="Nachname" Style="{StaticResource FieldLabel}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LastName}" Style="{StaticResource FieldValue}" />
            </Grid>

            <!-- PC und Drucker -->
            <TextBlock Text="Arbeitsplatz und Drucker" FontWeight="Bold" Margin="0,16,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Windows-PC" Style="{StaticResource FieldLabel}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ComputerName}" Style="{StaticResource FieldValue}" />
                <TextBlock Grid.Row="1" Text="Zebra-Drucker" Style="{StaticResource FieldLabel}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PrinterName}" Style="{StaticResource FieldValue}" />
                <TextBlock Grid.Row="2" Text="Drucker-IP : Port" Style="{StaticResource FieldLabel}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PrinterAddress}" Style="{StaticResource FieldValue}" />
            </Grid>

            <!-- Vorschau -->
            <TextBlock Text="Etikettenvorschau" FontWeight="Bold" Margin="0,16,0,8" />
            <Border Background="#EEEEEE" Padding="16" CornerRadius="4" MinHeight="160">
                <views:LabelPreviewControl Model="{Binding Preview}" MaxHeight="300" HorizontalAlignment="Center" />
            </Border>

            <!-- Druck -->
            <Button Content="Ein Etikett drucken" Style="{StaticResource PrintButton}"
                    Command="{Binding PrintCommand}" Margin="0,20,0,8" />

            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#2E6B34"
                       HorizontalAlignment="Center" TextAlignment="Center" />
        </StackPanel>
    </ScrollViewer>
</Window>
